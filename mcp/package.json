  "description": "Model Context Protocol server that drives a RUNNING GMPI standalone plugin app — read and set parameters, inject MIDI, click and drag its GUI, screenshot it, and render its audio offline.",
  "license": "ISC",
  "author": "Jeff McClintock",
  "type": "module",
  "bin": {
    "gmpi-standalone-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
